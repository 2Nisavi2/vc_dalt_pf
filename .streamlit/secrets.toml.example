# Copie este archivo como .streamlit/secrets.toml (local) o pegue su contenido en
# Streamlit Community Cloud > App > Settings > Secrets. secrets.toml está en .gitignore.

# Prediction URL de la iteración publicada (Custom Vision > Prediction URL > "If you have an image file").
# Con o sin el sufijo /image.
CV_PREDICTION_ENDPOINT = "https://<region>.api.cognitive.microsoft.com/customvision/v3.0/Prediction/<project-id>/classify/iterations/<iteracion>/image"
CV_PREDICTION_KEY = "<prediction-key>"
